# OpenAI-compatible chat runtime
LLM_API_KEY=your_openai_compatible_key
LLM_BASE_URL=https://aihubmix.com/v1
LLM_MODEL=gpt-chat-latest
LLM_VISION_MODEL=gpt-chat-latest

# Optional Qwen-compatible fallback
QWEN_API_KEY=your_qwen_or_openai_compatible_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus

# LangGraph persistence and memory
GRAPH_BACKEND=auto
POSTGRES_DSN=postgresql://agriagent:agriagent@postgres:5432/agriagent

# Cache and RAG
REDIS_URL=redis://redis:6379/0
USE_REDIS_CACHE=true
USE_CHROMA=true
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=cucumber_irrigation_knowledge

# Enhanced PDF parsing. Keep repos, weights and caches inside this project.
PDF_PARSERS_ROOT=./.tools/pdf_parsers
DOCLAYOUT_YOLO_MODEL_PATH=./.tools/pdf_parsers/models/doclayout-yolo/doclayout_yolo_docstructbench_imgsz1024.pt
TABLE_TRANSFORMER_DETECTION_MODEL_DIR=./.tools/pdf_parsers/models/table-transformer-detection
TABLE_TRANSFORMER_STRUCTURE_MODEL_DIR=./.tools/pdf_parsers/models/table-transformer-structure-recognition-v1.1-all
ENABLE_PDF_VISION_PARSERS=true
PDF_VISION_MAX_PAGES=8
PDF_PARSER_DEVICE=cpu

# Tool protocol and observability
ENABLE_MCP=true
ENABLE_LANGSMITH=false
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=cucumber-irrigation-ai-travel

# Frontend runtime base path
VITE_API_BASE_URL=/api
